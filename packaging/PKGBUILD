# Maintainer: arigood99 <arigood99@gmail.com>
pkgname=mira-launcher
pkgver=0.7.0
pkgrel=1
pkgdesc="Linux game launcher for native games and Windows games via Wine/Proton"
arch=('x86_64')
url="https://github.com/AriGood/Mira"
license=('GPL3')
depends=('gcc-libs' 'curl' 'qt6-base')
makedepends=('cmake' 'ninja' 'clang')
optdepends=('wine: run Windows games without Proton'
           'umu-launcher: Proton support (AUR)'
           'winetricks: install DLL/redistributable fixes into a game prefix'
           'unzip: auto-extract .zip archives dropped into a library root'
           'unrar: auto-extract .rar archives dropped into a library root'
           'p7zip: auto-extract .7z archives dropped into a library root')
backup=()
source=("mira-$pkgver.tar.gz::https://github.com/AriGood/Mira/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1a748b8962ac8d2d22a432a8614f2cf236187d30115f5b92860de3e471cb5092')

build() {
  # GitHub's archive directory name varies by endpoint (Mira-<version> vs.
  # AriGood-Mira-<commit sha>, confirmed by testing both) -- there's exactly
  # one directory extracted here regardless of what it's named.
  cd "$srcdir"/*/
  cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -GNinja
  cmake --build build
}

package() {
  cd "$srcdir"/*/
  DESTDIR="$pkgdir" cmake --install build
}
